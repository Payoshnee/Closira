{
  "name": "closira",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web-admin",
    "services/api",
    "packages/shared-types",
    "packages/config"
  ],
  "scripts": {
    "dev:api": "npm --workspace services/api run start:dev",
    "dev:web": "npm --workspace apps/web-admin run dev",
    "test:api": "npm --workspace services/api run test",
    "lint": "npm --workspaces --if-present run lint",
    "test": "npm --workspaces --if-present run test"
  }
}

